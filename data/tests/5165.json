        { "id": "b", "content": { "format": "text", "value": "1/3" } },
        { "id": "c", "content": { "format": "text", "value": "1/2" } },
        { "id": "d", "content": { "format": "text", "value": "2/3" } }
      ],
      "correct": ["b"],
      "explanation": { "format": "text", "value": "The outcomes greater than 4 are 5 and 6 — two out of six equally likely outcomes, so the probability is 2/6 = 1/3." },
