.DS_Store
*.log
.env
.env.*

# ETS study companions — third-party copyrighted PDFs, reference only.
# See "The ETS copyright rule" in .claude/skills/dev-workflow/SKILL.md.
# "Unused Knowledge-Guides/" holds companions for subjects not yet in scope; it is
# the same copyrighted material and must never reach GitHub either.
Knowledge-Guides/
Unused Knowledge-Guides/

# Build output (if the project ever gains a build step)
dist/
node_modules/

# Python bytecode from tools/*.py
__pycache__/
*.pyc

# In-flight authoring output (durable across sessions; merged into banks, never committed raw)
.authoring/

# Blind-verification payloads and findings (derived; regenerate any time)
.verification/

# iOS app (ios/, D-44) -- Xcode build output and per-user state. The generated
# ios/PraxisMath.xcodeproj/project.pbxproj IS committed; only derived data is ignored.
ios/build/
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
